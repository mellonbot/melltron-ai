{
  // AI — lab app on ai.melltron.build.
  // Isolated by design: own repo, own Worker, own domain binding. Nothing in the
  // melltron.build root routes here; the root only lists it in content/lab.json.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "melltron-ai",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": true
  },
  "routes": [{ "pattern": "ai.melltron.build", "custom_domain": true }],
  // One canonical origin. Branch builds run `wrangler preview`, which needs the
  // previews block (empty is fine) and preview_urls to be reachable.
  "workers_dev": false,
  "preview_urls": true,
  "previews": {},
  // Non-secret config. Secrets (wrangler secret put): OLLAMA_CLIENT_ID, OLLAMA_CLIENT_SECRET, LOCALAI_API_KEY (optional, LocalAI API_KEY), PASS_SECRET (signs tailnet passes), ALERT_TO (owner's email for access-request alerts), REPO_QA_GITHUB_TOKEN (repository Q&A)
  // (the Access service token admitted by the LocalAI and Pi tunnels). Empty values fail closed.
  "vars": {
    // Ollama on the office desktop (RTX 4060), 127.0.0.1:11434. The hostname
    // localai-tunnel is the office tunnel; its origin is Ollama, not LocalAI.
    "OLLAMA_URL": "https://localai-tunnel.melltron.build",
    // Only these two. Empty would offer every model Ollama has installed.
    "OLLAMA_MODELS": "huihui_ai/qwen3.5-abliterated:9b,deepseek-9b-uncensored:latest",
    // LocalAI on the office desktop. Empty: the site does not use it.
    "LOCALAI_URL": "",
    "LOCALAI_MODELS": "",
    // Ollama on the Pi. Empty: the site does not use it.
    "PI_URL": "",
    // Open to anyone, no Access login. Needs the rate limits below (fails closed without).
    "PUBLIC": "true",
    // Who may use the models while PUBLIC is "true".
    // "tailnet" (default): /api/models and /api/chat require a valid tailnet pass.
    // "public": FREE_PROMPTS, then an access request. Any other value stays tailnet-only.
    "CHAT_ACCESS": "tailnet",
    // Free chats per visitor (and per IP) before the owner has to approve them.
    // Used only when CHAT_ACCESS is "public".
    "FREE_PROMPTS": "10",
    // AUD of the "AI admin" Access app covering /admin and /api/admin (owner only).
    // Sender for access-request alerts (melltron.build is an Email Sending domain).
    "ALERT_FROM": "ai@melltron.build",
    "ADMIN_ACCESS_AUD": "a8175735d7d0ea7ff901a760fef17bef932ae23edd7f12c3866c471d4e52e9d7",
    "ACCESS_TEAM_DOMAIN": "fancy-smoke-ad49.cloudflareaccess.com",
    "ACCESS_AUD": "ed4b66ee811bef7c3c9e7d1960a2a4ecda65a1e98836b8bf6ab6a62bdbdd6f7d",
    // Repository Q&A (src/repo-qa.js). Desktop model only; secret REPO_QA_GITHUB_TOKEN
    // is a fine-grained, Contents read-only token for mellonbot-status and melltron-ai.
    "REPO_QA_MODEL": "huihui_ai/qwen3.5-abliterated:9b",
    // AUD of the "Mellonpanel (melltron.cloud)" Access app (owner only). Accepted only on /api/repo-qa.
    "MELLONPANEL_ACCESS_AUD": "748f0a6c982f8698b4da71884673fbadc2d288af83f302eecdea7ce02d5ecb9d"
  },
  // Emails the owner about access requests (src/alert.js). Recipient: ALERT_TO secret.
  "send_email": [{ "name": "ALERT_EMAIL" }],
  // Visitor prompt counts and access requests (src/quota.js).
  "d1_databases": [{ "binding": "DB", "database_name": "melltron-ai", "database_id": "5788891a-23fd-432e-8f31-82acaf46acd6" }],
  // Per-IP limits (key: CF-Connecting-IP). Chat is what costs GPU or Pi time.
  "ratelimits": [
    { "name": "CHAT_LIMIT", "namespace_id": "3001", "simple": { "limit": 10, "period": 60 } },
    { "name": "MODELS_LIMIT", "namespace_id": "3002", "simple": { "limit": 30, "period": 60 } }
  ],
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "observability": { "enabled": true }
}
