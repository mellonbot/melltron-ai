{
  // AI — lab app on ai.melltron.build.
  // Isolated by design: own repo, own Worker, own domain binding. Nothing in the
  // melltron.build root routes here; the root only lists it in content/lab.json.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "melltron-ai",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": true
  },
  "routes": [{ "pattern": "ai.melltron.build", "custom_domain": true }],
  // One canonical origin. Branch builds run `wrangler preview`, which needs the
  // previews block (empty is fine) and preview_urls to be reachable.
  "workers_dev": false,
  "preview_urls": true,
  "previews": {},
  // Non-secret config. Secrets (wrangler secret put): OLLAMA_CLIENT_ID, OLLAMA_CLIENT_SECRET, PASS_SECRET (signs tailnet passes), ALERT_TO (owner's email for access-request alerts)
  // (the Access service token admitted by the Ollama and Hailo tunnels). Empty values fail closed.
  "vars": {
    // Ollama on the office desktop. Off: its tunnel (mellonlab-office) is disabled.
    // Set back to "https://ollama-tunnel.melltron.build" once the tunnel is re-enabled.
    "OLLAMA_URL": "",
    // hailo-ollama on the Pi (Hailo-10H), port 11434. Same service token; empty disables it.
    "HAILO_URL": "https://hailo-tunnel.melltron.build",
    // Open to anyone, no Access login. Needs the rate limits below (fails closed without).
    "PUBLIC": "true",
    // Free chats per visitor (and per IP) before the owner has to approve them.
    "FREE_PROMPTS": "10",
    // AUD of the "AI admin" Access app covering /admin and /api/admin (owner only).
    // Sender for access-request alerts (melltron.build is an Email Sending domain).
    "ALERT_FROM": "ai@melltron.build",
    "ADMIN_ACCESS_AUD": "a8175735d7d0ea7ff901a760fef17bef932ae23edd7f12c3866c471d4e52e9d7",
    "ACCESS_TEAM_DOMAIN": "fancy-smoke-ad49.cloudflareaccess.com",
    "ACCESS_AUD": "ed4b66ee811bef7c3c9e7d1960a2a4ecda65a1e98836b8bf6ab6a62bdbdd6f7d"
  },
  // Emails the owner about access requests (src/alert.js). Recipient: ALERT_TO secret.
  "send_email": [{ "name": "ALERT_EMAIL" }],
  // Visitor prompt counts and access requests (src/quota.js).
  "d1_databases": [{ "binding": "DB", "database_name": "melltron-ai", "database_id": "5788891a-23fd-432e-8f31-82acaf46acd6" }],
  // Per-IP limits (key: CF-Connecting-IP). Chat is what costs GPU / HAT time.
  "ratelimits": [
    { "name": "CHAT_LIMIT", "namespace_id": "3001", "simple": { "limit": 10, "period": 60 } },
    { "name": "MODELS_LIMIT", "namespace_id": "3002", "simple": { "limit": 30, "period": 60 } }
  ],
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "observability": { "enabled": true }
}
